/dts-v1/;
#include "mt6893.dtsi"
#include "mt6359.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/usb/pd.h>

/ {
        model = "Infinix Note 30 VIP";
        chassis-type = "handset";
        compatible = "infinix,x6710";

        chosen {
                #address-cells = <2>;
                #size-cells = <2>;
                ranges;

                bootargs = "console=tty0 console=ttyS0,921600 clk_ignore_unused regulator_ignore_unused pd_ignore_unused loglevel=7";

                framebuffer@76a10000 {
                        compatible = "simple-framebuffer";
                        reg = <0 0x76a10000 0 0x1df0000>;
                        width = <1080>;
                        height = <2400>;
                        stride = <((1080 + 8) * 4)>;
                        format = "a8r8g8b8";
                        status = "okay";
                };
        };


        memory@40000000 {
                device_type = "memory";
                reg = <0 0x40000000 0x3 0>;
        };

        reserved-memory {
                #address-cells = <2>;
                #size-cells = <2>;
                ranges;

                memory@ffe60000 {
                        reg = <0 0xffe60000 0 0x190000>;
                        no-map;
                };

                memory@74000000 {
                        reg = <0 0x74000000 0 0xe30000>;
                        no-map;
                };

                memory@88000000 {
                        reg = <0 0x88000000 0 0x5560000>;
                        no-map;
                };

                memory@8e000000 {
                        reg = <0 0x8e000000 0 0x910000>;
                        no-map;
                };

                memory@fa850000 {
                        reg = <0 0xfa850000 0 0x37b0000>;
                        no-map;
                };

                memory@e4000000 {
                        reg = <0 0xe4000000 0 0x7eb0000>;
                        no-map;
                };

                memory@e3000000 {
                        reg = <0 0xe3000000 0 0xf0000>;
                        no-map;
                };

                memory@e0000000 {
                        reg = <0 0xe0000000 0 0x2080000>;
                        no-map;
                };

                memory@bff70000 {
                        reg = <0 0xbff70000 0 0x10000>;
                        no-map;
                };

                memory@9fb00000 {
                        reg = <0 0x9fb00000 0 0x400000>;
                        no-map;
                };

                memory@75000000 {
                        reg = <0 0x75000000 0 0x10000>;
                        no-map;
                };

                memory@be510000 {
                        reg = <0 0xbe510000 0 0x18f0000>;
                        no-map;
                };

                memory@76a10000 {
                        reg = <0 0x76a10000 0 0x1df0000>;
                        no-map;
                };

                memory@7ffa0000 {
                        reg = <0 0x7ffa0000 0 0x8000>;
                        no-map;
                };

                memory@48170000 {
                        reg = <0 0x48170000 0 0x10000>;
                        no-map;
                };

                memory@48090000 {
                        reg = <0 0x48090000 0 0xe0000>;
                        no-map;
                };

                memory@48080000 {
                        reg = <0 0x48080000 0 0x10000>;
                        no-map;
                };

                memory@5ff00000 {
                        reg = <0 0x5ff00000 0 0x80000>;
                        no-map;
                };

                memory@7ed00000 {
                        reg = <0 0x7ed00000 0 0x100000>;
                        no-map;
                };

                memory@78800000 {
                        reg = <0 0x78800000 0 0x6000000>;
                        no-map;
                };

                memory@7fea0000 {
                        reg = <0 0x7fea0000 0 0x100000>;
                        no-map;
                };

                memory@7e800000 {
                        reg = <0 0x7e800000 0 0x400000>;
                        no-map;
                };

                memory@bfe00000 {
                        reg = <0 0xbfe00000 0 0x40000>;
                        no-map;
                };

                memory@bff80000 {
                        reg = <0 0xbff80000 0 0x80000>;
                        no-map;
                };

                memory@48c00000 {
                        reg = <0 0x48c00000 0 0x200000>;
                        no-map;
                };

                memory@7ffaf000 {
                        reg = <0 0x7ffaf000 0 0x10000>;
                };

                memory@7ffbf000 {
                        reg = <0 0x7ffbf000 0 0x40000>;
                };

                memory@7ec00000 {
                        reg = <0 0x7ec00000 0 0x41000>;
                };

                memory@7ee00000 {
                        reg = <0 0x7ee00000 0 0x1000000>;
                        no-map;
                };

                memory@7ffff000 {
                        reg = <0 0x7ffff000 0 0x1000>;
                        no-map;
                };
        };

	ufs_dummy_vcc: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "vreg_ufs_vcc";

		regulator-min-microvolt = <2900000>;
		regulator-max-microvolt = <2900000>;

		regulator-always-on;
		regulator-boot-on;
	};

        vusb33: regulator-vusb33 {
                compatible = "regulator-fixed";
                regulator-name = "vusb33";
                regulator-min-microvolt = <3300000>;
                regulator-max-microvolt = <3300000>;
                regulator-always-on;
        };

};

&i2c5 {
    status = "okay";
    clock-frequency = <400000>;
    clock-div = <1>;

    mt6360: pmic@34 {
        compatible = "mediatek,mt6360";
        reg = <0x34>;
        interrupt-parent = <&pio>;
        interrupts = <24 IRQ_TYPE_EDGE_FALLING>;
        interrupt-controller;
        #interrupt-cells = <1>;
        wakeup-source;

        charger {
            compatible = "mediatek,mt6360-chg";
            richtek,vinovp-microvolt = <14500000>;

            otg_vbus: usb-otg-vbus-regulator {
                regulator-name = "usb-otg-vbus";
                regulator-min-microvolt = <4425000>;
                regulator-max-microvolt = <5825000>;
            };
        };

        tcpc {
            compatible = "mediatek,mt6360-tcpc";
            interrupts-extended = <&pio 25 IRQ_TYPE_LEVEL_LOW>;
            interrupt-names = "PD_IRQB";

            connector {
                compatible = "usb-c-connector";
                label = "USB-C";
                power-role = "dual";
                data-role = "dual";
                pd-disable;

                port {
                    typec_hs: endpoint {
                        remote-endpoint = <&ssusb_hs>;
                    };
                };
            };
        };
    };
};

&ssusb {
    status = "okay";
    dr_mode = "otg";
    usb-role-switch;
    maximum-speed = "high-speed";
    mediatek,u3p-dis-msk = <1>;
    mediatek,force-vbus;
    vbus-supply = <&otg_vbus>;
    vusb33-supply = <&vusb33>;
    port { ssusb_hs: endpoint { remote-endpoint = <&typec_hs>; }; };
};

&usb_host {
    status = "okay";
    mediatek,force-vbus;
    vbus-supply = <&otg_vbus>;
    vusb33-supply = <&vusb33>;
};

&ufsphy { status = "okay"; };
&usb_phy { status = "okay"; };
&ufs {  status = "okay"; vcc-supply = <&ufs_dummy_vcc>; };
&uart0 { status = "okay"; };